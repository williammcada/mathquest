{
  "name": "mathquest-prototype",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "vite",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "build": "node scripts/validate-release.mjs",
    "dev:journey": "wrangler dev --local --assets public --port 8787 --var COMBAT_PUBLIC_BASE:http://127.0.0.1:8787 --var CORS_ALLOWED_ORIGINS:http://127.0.0.1:8787,http://localhost:8787",
    "build:ironbreak": "node scripts/build-ironbreak-practice.mjs && node scripts/build-ironbreak-review.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "happy-dom": "^20.14.3",
    "vite": "^7.1.5",
    "wrangler": "^4.0.0"
  }
}
