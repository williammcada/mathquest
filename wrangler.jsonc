{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathquest-prototype",
  "workers_dev": true,
  "main": "src/worker.js",
  "compatibility_date": "2025-04-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "QuestSession"
      },
      {
        "name": "BRAWLS",
        "class_name": "BrawlRun"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "QuestSession"
      ]
    },
    {
      "tag": "jttw-v1",
      "new_sqlite_classes": [
        "BrawlRun"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "vars": {
    "CORS_ALLOWED_ORIGINS": "https://williammcada.github.io,https://vault7mathquest.netlify.app,https://mcada-mathquest.onrender.com",
    "COMBAT_PUBLIC_BASE": "https://mathquest-prototype.willmcada-apps.workers.dev"
  }
}
